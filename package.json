    "codemirror": "6.0.2",
    "highlight.js": "11.11.2",
    "katex": "0.16.47",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
